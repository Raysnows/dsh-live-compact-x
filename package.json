{
  "name": "dsh-live-compact-x",
  "version": "1.4.7",
  "icon": "./icon.svg",
  "description": "DSH 压缩增强：抢在官方 compaction-basic 的阈值之前先切尾巴（净收益门槛 + 零副本存储 + 中刀/大刀），把官方大压缩尽量往后推；官方摘要逻辑原样继承（super 兜底），可随时卸载。",
  "license": "MIT",
  "author": "Raysnows <Raysnows@users.noreply.github.com>",
  "type": "module",
  "main": "shell.js",
  "bin": {
    "dsh-live-compact-x": "bin/dsh-live-compact.js"
  },
  "exports": {
    ".": "./shell.js",
    "./client": "./client.js",
    "./engine": "./src/engine/index.js",
    "./gate": "./src/engine/gate.js",
    "./shadow-search": "./src/engine/shadow-search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "icon.svg",
    "cordis.patch.yml",
    "shell.js",
    "client.js",
    "src",
    "bin",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "compaction",
    "context-window",
    "prefix-cache",
    "token",
    "cost",
    "memory",
    "agent",
    "harness",
    "web-ui",
    "ui"
  ],
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raysnows/dsh-live-compact-x.git"
  },
  "homepage": "https://github.com/Raysnows/dsh-live-compact-x#readme",
  "bugs": {
    "url": "https://github.com/Raysnows/dsh-live-compact-x/issues"
  },
  "contributors": [
    {
      "name": "MerkyorLynn",
      "url": "https://github.com/Tranquillitatis-Lab/dsh-live-compact",
      "comment": "original dsh-live-compact (MIT)"
    }
  ]
}
